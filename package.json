{
  "name": "hexo-theme-febirdy",
  "version": "0.1.0",
  "private": true,
  "description": "基于 Aomori 演进的现代 Hexo 主题，支持响应式布局、深浅色模式和可配置的搜索与评论",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandy1108/hexo-theme-febirdy.git"
  },
  "homepage": "https://github.com/sandy1108/hexo-theme-febirdy#readme",
  "bugs": {
    "url": "https://github.com/sandy1108/hexo-theme-febirdy/issues"
  },
  "keywords": ["hexo", "hexo-theme", "blog-theme", "febirdy", "aomori"],
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "layout",
    "languages",
    "scripts",
    "source",
    "tools",
    "docs/AOMORI-UPSTREAM.md",
    "_config.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "preview:build": "node tools/preview.cjs",
    "dev": "gulp",
    "build": "gulp build",
    "lint": "eslint ./source/javascripts/ --ext .js --fix",
    "lint:check": "eslint ./source/javascripts/ --ext .js",
    "stylelint": "stylelint source/stylesheets/**/*.scss --fix",
    "stylelint:check": "stylelint 'source/stylesheets/**/*.scss'",
    "test:fixture": "node tools/verify-fixture.cjs",
    "test": "npm run lint:check && npm run stylelint:check && npm run build && npm run test:fixture",
    "release": "standard-version -s"
  },
  "dependencies": {
    "dayjs": "^1.11.2",
    "jquery": "^3.6.0",
    "jquery-viewer": "^1.0.1",
    "viewerjs": "^1.10.5"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "@babel/core": "^7.18.2",
    "@babel/preset-env": "^7.18.2",
    "@rollup/plugin-babel": "^5.3.1",
    "@rollup/plugin-commonjs": "^22.0.0",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@ronilaukkarinen/gulp-stylelint": "^14.0.6",
    "hexo": "^8.1.2",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "3.4.0",
    "gulp": "^5.0.1",
    "gulp-autoprefixer": "^8.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-concat": "^2.6.1",
    "gulp-eslint-new": "^2.6.2",
    "gulp-plumber": "^1.2.1",
    "gulp-sass": "^5.1.0",
    "js-yaml": "^4.1.0",
    "postcss": "^8.4.14",
    "prettier": "^2.6.2",
    "rollup": "^2.75.5",
    "@rollup/plugin-terser": "^1.0.0",
    "sass": "^1.52.2",
    "standard-version": "^9.5.0",
    "stylelint": "^14.8.5",
    "stylelint-config-sass-guidelines": "^9.0.1",
    "stylelint-config-standard": "^25.0.0",
    "stylelint-scss": "^4.2.0"
  }
}
