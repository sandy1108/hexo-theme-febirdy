<% Object.keys(config.febirdy_social || {}).forEach(function (key){ %>
    <% var social = config.febirdy_social[key]; %>
    <% if (social){ %>
        <a class="social" target="_blank" href="<%- social.url %>">
            <ion-icon name="<%- social.icon %>"></ion-icon>
        </a>
    <% } %>
<% }) %>
