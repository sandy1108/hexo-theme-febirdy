<%
    const giscusConfig = config.febirdy_giscus || {};
    const themeMode = theme && theme.febirdy_theme ? theme.febirdy_theme.default : 'dark';
    // Giscus 只接受 light/dark/preferred_color_scheme；初始值与主题默认模式保持一致，运行时再同步用户选择。
    const giscusInitialTheme = themeMode === 'light'
        ? 'light'
        : (themeMode === 'auto' ? 'preferred_color_scheme' : 'dark');
%>

<% if (config.febirdy_disqus_shortname){ %>
<section class="comments comments-disqus">
    <div id="disqus_thread"></div>
    <script>
        ;(function () {
            // DON'T EDIT BELOW THIS LINE
            var d = document,
                s = d.createElement('script')
            s.src =
                'https://<%- config.febirdy_disqus_shortname %>.disqus.com/embed.js'
            s.setAttribute('data-timestamp', +new Date())
            ;(d.head || d.body).appendChild(s)
        })()
    </script>
</section>
<% } %>

<% if (febirdy_feature_enabled(config.febirdy_disqusjs)){ %>
<section class="comments comments-disqusjs">
    <div id="disqus_thread"></div>
</section>
<% } %>

<% if (febirdy_feature_enabled(config.febirdy_gitalk)){ %>
<section class="comments">
    <div id="gitalk-container"></div>
</section>
<% } %>

<% if (febirdy_feature_enabled(config.febirdy_valine)){ %>
<section class="comments">
    <div id="valine-container"></div>
</section>
<script src="//unpkg.com/valine/dist/Valine.min.js"></script>
<% } %>

<% if (febirdy_feature_enabled(config.febirdy_remark42)){ %>
<section id="remark42"></section>
<script>
    (function() {
        window.remark_config = {
            host: "<%= config.febirdy_remark42.host || '' %>",
            site_id: "<%= config.febirdy_remark42.site_id || '' %>",
            max_shown_comments: "<%= config.febirdy_remark42.max_shown_comments || 15 %>",
            theme: "<%= config.febirdy_remark42.theme || 'dark' %>",
            locale: "<%= config.febirdy_remark42.locale || 'en' %>",
            show_email_subscription: "<%= config.febirdy_remark42.show_email_subscription || false %>",
            components: ['embed']
        }
        var d = document, s = d.createElement('script');
        s.src = remark_config.host + '/web/embed.js';
        s.defer = true;
        (d.head || d.body).appendChild(s);
    })();
</script>
<% } %>

<% if (febirdy_feature_enabled(giscusConfig)){ %>
<section class="comments">
    <div class="giscus"></div>
</section>
<script src="https://giscus.app/client.js"
    data-repo="<%= giscusConfig.repo || '' %>"
    data-repo-id="<%= giscusConfig.repoId || '' %>"
    data-category="<%= giscusConfig.category || '' %>"
    data-category-id="<%= giscusConfig.categoryId || '' %>"
    data-mapping="<%= giscusConfig.mapping || 'pathname' %>"
    data-reactions-enabled="<%= typeof giscusConfig.reactionsEnabled === 'undefined' ? '1' : giscusConfig.reactionsEnabled %>"
    data-emit-metadata="<%= typeof giscusConfig.emitMetadata === 'undefined' ? '0' : giscusConfig.emitMetadata %>"
    data-theme="<%= giscusInitialTheme %>"
    data-lang="<%= giscusConfig.lang || 'zh-CN' %>"
    crossorigin="anonymous"
    async>
</script>
<% } %>
