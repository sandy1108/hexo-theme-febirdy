<%
  const galleryPhotos = Array.isArray(post.photos) ? post.photos.filter(Boolean) : [];
  const galleryAlt = post.title || config.title || '文章图片';
%>
<% if (galleryPhotos.length){ %>

<div class="swiper-container article-gallery">
  <div class="swiper-wrapper">
    <% galleryPhotos.forEach(function(photo, i){ %>
      <div class="swiper-slide">
        <img src="<%- url_for(photo) %>" itemprop="image" alt="<%= galleryAlt %>">
      </div>
    <% }) %>
  </div>
  <!-- 如果需要分页器 -->
  <div class="swiper-pagination"></div>
</div>

<% } %>
