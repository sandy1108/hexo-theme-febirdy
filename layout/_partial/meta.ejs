<%
    var title = page.title;
    // 统一序列化结构化数据，避免站点文案中的引号、换行破坏 JSON-LD。
    // 同时转义 HTML 原始文本中的危险字符，避免文案意外闭合 script 标签。
    var serializeJsonLd = function (data) {
        return JSON.stringify(data)
            .replace(/</g, '\\u003c')
            .replace(/>/g, '\\u003e')
            .replace(/&/g, '\\u0026');
    };
    var logoPath = config.febirdy_logo || config.favicon || '/favicon.ico';
    var logoUrl = logoPath;
    if (!/^(?:[a-z][a-z0-9+.-]*:|\/\/)/i.test(logoPath)) {
        logoUrl = (config.url || '').replace(/\/$/, '') + '/' + logoPath.replace(/^\//, '');
    }
    if (is_archive()){
        title = __('Archive');
        if (is_month()){
            title += ' | ' + page.year + '/' + page.month;
        } else if (is_year()){
            title += ' | ' + page.year;
        }
    } else if (is_category()){
        title = __('Category') + ' | ' + page.category;
    } else if (is_tag()){
        title = __('Tag') + ' | ' + page.tag;
    }
    var siteTitle = config.title || config.author || 'Blog';
    var pageTitle = title || siteTitle;
    var fullTitle = pageTitle === siteTitle ? siteTitle : pageTitle + ' | ' + siteTitle;
    var descriptionSource = page.description || page.excerpt || config.description || siteTitle;
    var description = strip_html(String(descriptionSource)).replace(/\s+/g, ' ').trim();
    var siteName = config.siteName || siteTitle;
    var publisherName = config.publisher || config.author || siteTitle;
%>
<% if(is_post()){ %>
    <meta property="og:locale" content="<%= config.language %>" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content="<%= fullTitle %>" />
    <meta property="og:description" content="<%= description %>" />
    <meta property="og:url" content="<%= url %>" />
    <meta property="og:site_name" content="<%= siteName %>" />
    <meta property="article:author" content="<%= config.author || publisherName %>" />
    <meta property="article:publisher" content="<%= publisherName %>" />
    <meta name="twitter:title" content="<%= fullTitle %>"/>
    <meta name="twitter:description" content="<%= description %>"/>
    <script type="application/ld+json"><%- serializeJsonLd({
        description: description,
        author: { '@type': 'Person', name: config.author || publisherName },
        '@type': 'BlogPosting',
        url: url,
        publisher: {
            '@type': 'Organization',
            logo: {
                '@type': 'ImageObject',
                url: logoUrl
            },
            name: publisherName
        },
        headline: pageTitle,
        datePublished: page.date.toISOString(),
        mainEntityOfPage: {
            '@type': 'WebPage',
            '@id': url
        },
        '@context': 'https://schema.org'
    }) %></script>
<% } %>

<% if(is_home() || is_page()){ %>
    <meta property="og:type" content="website"/>
    <meta property="og:title" content="<%= fullTitle %>"/>
    <meta property="og:description" content="<%= description %>"/>
    <meta property="og:locale" content="<%= config.language %>" />
    <meta property="og:url" content="<%= url %>" />
    <meta property="og:site_name" content="<%= siteName %>" />
    <script type="application/ld+json"><%- serializeJsonLd({
        '@context': 'https://schema.org',
        '@type': is_home() ? 'WebSite' : 'WebPage',
        url: url,
        name: pageTitle,
        description: description,
        publisher: {
            '@type': 'Organization',
            name: publisherName
        }
    }) %></script>
<% } %>
