<%
    // Hexo 允许使用 cn、zh 等简写；输出标准 BCP 47 语言标记供浏览器和辅助技术识别。
    var configuredLanguage = Array.isArray(config.language)
        ? config.language[0]
        : (config.language || (theme && theme.language) || 'en');
    var languageAliases = {
        cn: 'zh-CN',
        zh: 'zh-CN',
        'zh-cn': 'zh-CN',
        'zh-tw': 'zh-TW',
        en: 'en',
        ja: 'ja',
        it: 'it'
    };
    var normalizedLanguage = String(configuredLanguage || 'en').replace('_', '-').toLowerCase();
    var htmlLanguage = languageAliases[normalizedLanguage] || normalizedLanguage || 'en';
%>
<!DOCTYPE html>
<html lang="<%= htmlLanguage %>">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <%
        var title = page.title;
        if (is_archive()){
            title = __('Archive');
            if (is_month()){
                title += ' | ' + page.year + '/' + page.month;
            } else if (is_year()){
                title += ' | ' + page.year;
            }
        } else if (is_category()){
            title = __('Category') + ' | ' + page.category;
        } else if (is_tag()){
            title = __('Tag') + ' | ' + page.tag;
        }
    %>
    <title><% if (title){ %><%= title %> | <% } %><%= config.title %></title>

    <meta name="description" content="<%= page.description || page.excerpt || config.description || config.title %>">
    <meta name="keywords" content="<%= page.keywords || config.keywords %>">

    <% var themeConfig = theme.febirdy_theme || {}; %>
    <% var themeModes = ['auto', 'light', 'dark']; %>
    <% var themeDefault = themeModes.indexOf(themeConfig.default) !== -1 ? themeConfig.default : 'dark'; %>
    <% var algoliaConfig = febirdy_algolia_config(); %>
    <% var searchAlgoliaEnabled = febirdy_algolia_enabled(); %>
    <% var gitalkEnabled = febirdy_feature_enabled(config.febirdy_gitalk); %>
    <% var valineEnabled = febirdy_feature_enabled(config.febirdy_valine); %>
    <% var disqusjsEnabled = febirdy_feature_enabled(config.febirdy_disqusjs); %>
    <% var serializeClientConfig = function (value) {
        return JSON.stringify(value)
            .replace(/</g, '\\u003c')
            .replace(/>/g, '\\u003e')
            .replace(/&/g, '\\u0026');
    }; %>
    <meta name="color-scheme" content="light dark">
    <script>
        // 在样式加载前恢复主题，避免浅色模式首次绘制时短暂闪回深色。
        (function () {
            var modes = ['auto', 'light', 'dark']
            var defaultMode = '<%= themeDefault %>'
            var selectedMode = defaultMode
            var systemIsLight = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches

            try {
                var savedMode = window.localStorage.getItem('febirdy-theme')
                if (modes.indexOf(savedMode) !== -1) selectedMode = savedMode
            } catch (error) {
                // 隐私模式或禁用存储时，使用主题配置中的默认值。
            }

            var effectiveMode = selectedMode === 'auto' && systemIsLight ? 'light' : selectedMode === 'auto' ? 'dark' : selectedMode
            document.documentElement.setAttribute('data-theme', selectedMode)
            document.documentElement.setAttribute('data-theme-effective', effectiveMode)
            document.documentElement.style.colorScheme = selectedMode === 'auto' ? 'light dark' : selectedMode
        })()
    </script>

    <%- partial('_partial/meta') %>

    <% if (config.febirdy_google_site && config.febirdy_google_site.enable){ %>
    <meta name="google-site-verification" content="<%= config.febirdy_google_site.id %>" />
    <% } %>

    <% if (searchAlgoliaEnabled){ %>
    <meta property="algolia:search"
        data-application-id="<%= algoliaConfig.applicationId %>"
        data-api-key="<%= algoliaConfig.apiKey %>"
        data-index-name="<%= algoliaConfig.indexName %>">
    <% } %>

    <% if (config.rss){ %>
    <link rel="alternate" href="<%= url_for(config.rss) %>" title="<%= config.title %>" type="application/atom+xml">
    <% } %>

    <% if (config.favicon){ %>
    <link rel="icon" href="<%- config.favicon %>">
    <% } %>

    <% if (config.febirdy_favicon){ %>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22><%- config.febirdy_favicon %></text></svg>">
    <% } %>

    <% if (gitalkEnabled){ %>
    <link rel="stylesheet" href="https://unpkg.com/gitalk/dist/gitalk.css">
    <% } %>

    <% if (disqusjsEnabled){ %>
    <link rel="stylesheet" href="https://unpkg.com/disqusjs@1.3/dist/disqusjs.css">
    <% } %>

    <%- css(`/dist/build.css?v=${theme.version}`) %>

    <%- css(`/dist/custom.css?v=${theme.version}`) %>
    <%- css(`/stylesheets/febirdy.css?v=${theme.version}`) %>

    <script>
        window.isPost = <%- serializeClientConfig(is_post()) %>
        window.febirdy = {
            <% if (gitalkEnabled){ %>
            gitalk: <%- serializeClientConfig({
                enable: gitalkEnabled,
                clientID: config.febirdy_gitalk.clientID || '',
                clientSecret: config.febirdy_gitalk.clientSecret || '',
                repo: config.febirdy_gitalk.repo || '',
                owner: config.febirdy_gitalk.owner || '',
                admin: Array.isArray(config.febirdy_gitalk.admin) ? config.febirdy_gitalk.admin : [],
                distractionFreeMode: Boolean(config.febirdy_gitalk.distractionFreeMode)
            }) %>,
            <% } %>
            <% if (valineEnabled){ %>
            valine: <%- serializeClientConfig({
                enable: valineEnabled,
                appId: config.febirdy_valine.appId || '',
                appKey: config.febirdy_valine.appKey || '',
                placeholder: config.febirdy_valine.placeholder || 'Hello World!',
                avatar: config.febirdy_valine.avatar || '',
                pageSize: config.febirdy_valine.pageSize || '10',
                lang: config.febirdy_valine.lang || 'zh-CN',
                visitor: Boolean(config.febirdy_valine.visitor),
                highlight: Boolean(config.febirdy_valine.highlight),
                recordIP: Boolean(config.febirdy_valine.recordIP),
                emojiCDN: config.febirdy_valine.emojiCDN || '',
                enableQQ: Boolean(config.febirdy_valine.enableQQ),
                requiredFields: Array.isArray(config.febirdy_valine.requiredFields) ? config.febirdy_valine.requiredFields : []
            }) %>,
            <% } %>
            <% if (disqusjsEnabled){ %>
            disqusjs: <%- serializeClientConfig({
                enable: disqusjsEnabled,
                shortname: config.febirdy_disqusjs.shortname || '',
                siteName: config.febirdy_disqusjs.siteName || '',
                api: config.febirdy_disqusjs.api || 'https://disqus.skk.moe/disqus/',
                apikey: config.febirdy_disqusjs.apikey || '',
                nesting: config.febirdy_disqusjs.nesting || 4,
                nocomment: config.febirdy_disqusjs.nocomment || '这里冷冷清清的，一条评论都没有',
                admin: config.febirdy_disqusjs.admin || '',
                adminLabel: config.febirdy_disqusjs.adminLabel || ''
            }) %>,
            <% } %>
        }
        window.febirdy_logo_typed_animated = <%- serializeClientConfig(Boolean(config.febirdy_logo_typed_animated)) %>
        window.febirdy_search_algolia = <%- serializeClientConfig(searchAlgoliaEnabled) %>

        // 兼容仍引用旧全局对象的评论插件或站点自定义脚本。
        window.aomori = window.febirdy
        window.aomori_logo_typed_animated = window.febirdy_logo_typed_animated
        window.aomori_search_algolia = window.febirdy_search_algolia

    </script>

</head>
