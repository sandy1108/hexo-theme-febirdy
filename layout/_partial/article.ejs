<article id="<%= post.layout %>-<%= post._id %>" class="article fb-post" itemscope itemprop="blogPost">
  <% if (!post.video){ %><%- partial('post/gallery') %><% } %>
  <header class="fb-post-header">
    <div class="fb-post-kicker">
      <% if (post.categories && post.categories.length){ %><%- list_categories(post.categories, {show_count:false, style:'none', separator:'', depth:1}) %><% } %>
      <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
      <% if (post.updated){ %><span>更新于 <%= date(post.updated, 'YYYY-MM-DD') %></span><% } %>
    </div>
    <%- partial('post/title', {class_name: 'fb-post-title'}) %>
    <% if (post.tags && post.tags.length){ %><div class="fb-post-tags"><%- list_tags(post.tags, {show_count:false, amount:8}) %></div><% } %>
  </header>
  <div class="fb-post-grid">
    <div class="fb-post-content post-inner-html" itemprop="articleBody"><%- post.content %></div>
  </div>
  <% if (post.layout !== 'tweet') { %>
    <%- partial('post/reprint') %>
    <%- partial('post/refer') %>
    <%- partial('post/copyright') %>
    <%- partial('post/nav') %>
  <% } %>
</article>
<%- partial('post/ad') %>
<%- partial('post/comments') %>
<% if (config.aomori_busuanzi){ %><script src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script><% } %>
