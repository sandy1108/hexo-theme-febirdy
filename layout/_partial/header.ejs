<% const menus = theme.febirdy_menu || {'首页':'/','归档':'/archives/','分类':'/categories/','标签':'/tags/','关于':'/about/'}; %>
<header class="fb-header">
  <div class="fb-header-inner">
    <a class="fb-brand" href="<%- url_for('/') %>" aria-label="FEBIRDY BLOG 首页">
      <svg class="fb-logo" viewBox="0 0 32 32" aria-hidden="true"><path d="M7 8l9 8 9-8v6l-9 8-9-8z"/><path d="M7 17l9 8 9-8"/></svg>
      <span>FEBIRDY <b>BLOG</b></span>
    </a>
    <nav class="fb-nav" aria-label="主导航"><% Object.keys(menus).forEach(function(label){ %><a href="<%- url_for(menus[label]) %>"><%= label %></a><% }) %></nav>
    <div class="fb-actions">
      <button class="fb-icon-button fb-search-trigger" type="button" aria-label="搜索">⌕ <span>搜索</span></button>
      <a class="fb-portal" href="https://febirdy.com" target="_blank" rel="noopener">传送门 ↗</a>
      <button class="fb-menu-button" type="button" aria-label="打开导航" aria-expanded="false">☰</button>
    </div>
  </div>
  <nav class="fb-mobile-nav" aria-label="移动端导航">
    <% Object.keys(menus).forEach(function(label){ %><a href="<%- url_for(menus[label]) %>"><%= label %></a><% }) %>
    <a href="https://febirdy.com">个人传送门 ↗</a>
  </nav>
</header>
